; Engine configuration file.
config_version=5

[application]

config/name="GHOST TRAIN: THE LAST ROUTE"
config/description="Cooperative PS1-style survival horror for 1-4 players."
config/version="1.0.0"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.02, 0.03, 1)
boot_splash/show_image=false
config/icon="res://assets/ui/icon.png"

[audio]

driver/mix_rate=44100

[autoload]

Settings="*res://scripts/core/settings.gd"
Loc="*res://scripts/core/loc.gd"
ItemDB="*res://scripts/inventory/item_db.gd"
Audio="*res://scripts/core/audio.gd"
Net="*res://scripts/multiplayer/net.gd"
GameState="*res://scripts/core/game_state.gd"
Actions="*res://scripts/core/player_actions.gd"
Quests="*res://scripts/quests/quest_manager.gd"
SaveSystem="*res://scripts/save_system/save_system.gd"
SceneFlow="*res://scripts/core/scene_flow.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="interactables"
3d_physics/layer_4="enemies"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/positional_shadow/atlas_size=1024
environment/defaults/default_clear_color=Color(0.01, 0.012, 0.02, 1)
